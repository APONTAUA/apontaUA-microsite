---
import { Icon } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';

interface Props {
	/** Docs folder holding the minutes, e.g. 'milestones/semester-1/meetings' */
	dir: string;
}

const { dir } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Every page in the folder except its index, ordered like the sidebar
const minutes = (await getCollection('docs', ({ id }) => id.startsWith(`${dir}/`)))
	.sort((a, b) => (a.data.sidebar.order ?? 0) - (b.data.sidebar.order ?? 0))
	.map(({ id, data }) => ({
		href: `${base}/${id}/`,
		label: data.sidebar.label ?? data.title,
		topic: data.title.split('—').slice(1).join('—').trim(),
	}));
---

{
	minutes.length > 0 ? (
		<div class="meeting-grid not-content">
			{minutes.map(({ href, label, topic }) => (
				<a class="meeting-card" href={href}>
					<span class="icon"><Icon name="document" size="1.4rem" /></span>
					<span class="body">
						<strong>{label}</strong>
						{topic && <span class="topic">{topic}</span>}
					</span>
					<span class="arrow"><Icon name="right-arrow" size="1.1rem" /></span>
				</a>
			))}
		</div>
	) : (
		<p class="empty not-content">No meetings yet. Minutes will be added here as the semester progresses.</p>
	)
}

<style>
	.meeting-grid {
		display: grid;
		gap: 1.5rem 2rem;
		margin-top: 2rem;
	}

	@media (min-width: 50rem) {
		.meeting-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.meeting-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 5.75rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--sl-color-gray-6);
		color: inherit;
		text-decoration: none;
		transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
	}

	.meeting-card:hover {
		transform: translateY(-3px);
		border-color: var(--sl-color-accent);
		box-shadow: 0 16px 32px -24px var(--sl-color-accent);
	}

	.icon {
		display: inline-grid;
		flex-shrink: 0;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 0.7rem;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
	}

	.body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	strong {
		color: var(--sl-color-white);
		font-family: 'Outfit', var(--sl-font);
		font-size: var(--sl-text-xl);
		font-weight: 700;
	}

	.topic {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.arrow {
		color: var(--sl-color-gray-3);
		transition: transform 200ms ease, color 200ms ease;
	}

	.meeting-card:hover .arrow {
		color: var(--sl-color-text-accent);
		transform: translateX(3px);
	}

	.empty {
		margin-top: 2rem;
		padding: 1.5rem;
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 1rem;
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
