---
import { Icon } from '@astrojs/starlight/components';

interface Props {
	title: string;
	href?: string;
	image?: string;
	alt?: string;
}

const { title, href, image, alt = `${title} profile photo` } = Astro.props;
const imageSrc = image?.startsWith('/')
	? `${import.meta.env.BASE_URL}${image.slice(1)}`
	: image;
const initials = title
	.split(/\s+/)
	.map((part) => part[0])
	.slice(0, 2)
	.join('')
	.toUpperCase();
---

<article class="team-card">
	<div class="avatar-frame">
		{imageSrc ? (
			<img class="avatar" src={imageSrc} alt={alt} loading="lazy" />
		) : (
			<span class="avatar avatar--fallback" aria-hidden="true">{initials}</span>
		)}
	</div>
	<div class="content">
		<strong>{title}</strong>
		<span class="description"><slot /></span>
	</div>
	<div class="profile-links">
		{href && (
			<a class="profile-link" href={href} aria-label={`${title} on GitHub`}>
				<Icon name="github" size="1.1rem" />
			</a>
		)}
	</div>
</article>

<style>
	.team-card {
		display: grid;
		grid-template-rows: auto 1fr auto;
		justify-items: center;
		gap: 1rem;
		min-width: 0;
		min-height: 17rem;
		padding: 1.25rem 1rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		text-align: center;
		transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}

	.team-card:hover {
		transform: translateY(-3px);
		border-color: var(--sl-color-text-accent);
		box-shadow: 0 14px 26px -18px var(--sl-color-accent);
	}

	.avatar-frame {
		display: grid;
		place-items: center;
		width: 7.25rem;
		aspect-ratio: 1;
		padding: 0.2rem;
		border: 2px solid var(--sl-color-accent-low);
		border-radius: 50%;
		background: var(--sl-color-gray-7);
		box-shadow: 0 5px 12px rgb(0 0 0 / 0.16);
	}

	.avatar {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
	}

	.avatar--fallback {
		display: grid;
		place-items: center;
		color: #fff;
		font-size: 1.5rem;
		font-weight: 750;
		background: linear-gradient(145deg, var(--aponta-action), var(--aponta-green-dark));
	}

	.content {
		display: grid;
		align-content: start;
		justify-items: center;
		gap: 0.45rem;
		width: 100%;
		min-width: 0;
		padding-top: 0.1rem;
	}

	strong {
		color: var(--sl-color-white);
		font-size: var(--sl-text-base);
		font-weight: 700;
		line-height: 1.35;
	}

	.description {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.45;
	}

	.profile-links {
		display: flex;
		justify-content: center;
		width: 100%;
		min-height: 2.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}

	.profile-link {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
		transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
	}

	.profile-link:hover {
		transform: translateY(-2px);
		background: var(--sl-color-accent);
		color: var(--sl-color-text-invert);
	}

	.profile-link:focus-visible {
		outline: 3px solid var(--sl-color-accent);
		outline-offset: 3px;
	}
</style>
