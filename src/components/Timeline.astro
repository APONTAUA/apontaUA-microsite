---
import { milestones } from '../data/milestones';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const labels = { done: 'Completed', current: 'In progress', upcoming: 'Upcoming' } as const;
---

<ol class="timeline">
	{
		milestones.map((ms) => (
			<li class:list={['reveal', ms.status]}>
				<span class="dot" />
				<a href={`${base}/${ms.href}`}>
					<span class="meta">
						<span class="code">{ms.code}</span>
						<span class="status">{labels[ms.status]}</span>
					</span>
					<strong>{ms.title}</strong>
					<span class="date">{ms.date}</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.timeline {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 50rem) {
		.timeline {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	li {
		position: relative;
		margin: 0;
		padding-top: 1.5rem;
	}

	/* Connecting line (only when milestones sit side by side) */
	li::before {
		display: none;
		content: '';
		position: absolute;
		top: 0.45rem;
		left: 0;
		right: -1rem;
		height: 2px;
		background: var(--sl-color-gray-5);
	}

	@media (min-width: 50rem) {
		li::before {
			display: block;
		}
	}

	li:last-child::before {
		right: 0;
	}

	li.done::before {
		background: var(--sl-color-accent);
	}

	.dot {
		position: absolute;
		top: 0;
		left: 0;
		width: 1rem;
		height: 1rem;
		border: 3px solid var(--sl-color-gray-5);
		border-radius: 50%;
		background: var(--sl-color-black);
	}

	.done .dot {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
	}

	.current .dot {
		border-color: var(--sl-color-accent);
		animation: pulse 2s ease-out infinite;
	}

	a {
		display: grid;
		gap: 0.35rem;
		height: 100%;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: inherit;
		text-decoration: none;
		transition: transform 200ms ease, border-color 200ms ease;
	}

	a:hover {
		transform: translateY(-3px);
		border-color: var(--sl-color-accent);
	}

	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.code {
		color: var(--sl-color-text-accent);
		font-weight: 800;
	}

	.status {
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		font-weight: 600;
	}

	.done .status,
	.current .status {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
	}

	strong {
		color: var(--sl-color-white);
	}

	.date {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	@keyframes pulse {
		0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--sl-color-accent) 60%, transparent); }
		100% { box-shadow: 0 0 0 12px transparent; }
	}
</style>
